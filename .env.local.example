# Copy to .env.local and fill in. Nothing here is required to run `npm run dev` —
# the site falls back to placeholder content when these are blank.

# --- Sanity (free tier) ------------------------------------------------------
# From sanity.io/manage after creating a project, or `npx sanity init`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-29

# --- Cloudflare R2 -----------------------------------------------------------
# Public bucket URL or bound custom domain, e.g. https://media.veerlabs.com
# Only needed if Sanity stores bare object keys instead of absolute URLs.
NEXT_PUBLIC_R2_PUBLIC_URL=
